		"y-indexeddb": "^9.0.12",
		"y-protocols": "^1.0.7",
		"yjs": "^13.6.31"
	},
	"devDependencies": {
		"@types/node": "^26.0.1",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.25.0",
		"fake-indexeddb": "^6.2.5",
		"obsidian": "^1.7.2",
		"oxfmt": "0.60.0",
		"oxlint": "1.75.0",
		"typescript": "7.0.2",
		"vitest": "4.1.10"
