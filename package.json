		"y-protocols": "1.0.7",
		"yjs": "13.6.32"
	},
	"devDependencies": {
		"@types/node": "26.1.1",
		"builtin-modules": "4.0.0",
		"esbuild": "0.25.12",
		"fake-indexeddb": "6.2.5",
		"obsidian": "1.11.4",
		"oxfmt": "0.60.0",
		"oxlint": "1.75.0",
		"typescript": "7.0.2",
		"vitest": "4.1.10",
		"y-indexeddb": "9.0.12"
	},
	"bison": {
		"workspaceMember": true
	},
	"packageManager": "pnpm@11.18.0"
